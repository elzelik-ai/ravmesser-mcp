# From Rav Messer: Settings > External connections (API) > "General account key" (turn it on)
RESPONDER_CLIENT_ID=
RESPONDER_CLIENT_SECRET=
RESPONDER_USER_TOKEN=
# Random secret that protects the server URL. Generate with: openssl rand -hex 32
MCP_ACCESS_TOKEN=
# true = only read tools (no adding, changing or deleting)
RESPONDER_READ_ONLY=false
PORT=3000
